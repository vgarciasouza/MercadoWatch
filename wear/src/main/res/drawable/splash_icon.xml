<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone da tela de abertura: a imagem do ícone sobre um círculo azul-marinho -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#FF142A45" />
        </shape>
    </item>
    <!-- Quadrado de 34dp: a diagonal (~48dp) cabe no círculo -->
    <item
        android:width="34dp"
        android:height="34dp"
        android:drawable="@drawable/icone_mercado"
        android:gravity="center" />
</layer-list>
