<?xml version="1.0" encoding="utf-8"?>
<!--
    Primeiro plano do ícone: a imagem icone_mercado.png (barras + cifrão) com 66dp,
    a área segura do ícone adaptativo de 108dp (inset de 21dp de cada lado). Assim a
    máscara redonda do relógio não corta as barras. As bordas da imagem já saem
    esmaecidas para se misturar com o fundo azul-marinho.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/icone_mercado"
    android:inset="21dp" />
